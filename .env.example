# ── Entorno ─────────────────────────────────────────────────────────────────
ENV=prod
LOG_LEVEL=INFO

# ── Base de datos ────────────────────────────────────────────────────────────
# SQLite (default — Railway usa /app/data montado en un Volume si se configura)
DATABASE_URL=sqlite+aiosqlite:///data/grantpulse.db

# ── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=YOUR_TOKEN_HERE
TELEGRAM_CHAT_ID=YOUR_CHAT_ID_HERE

# ── Email ────────────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=YOUR_EMAIL@gmail.com
SMTP_PASSWORD=YOUR_APP_PASSWORD_HERE
SMTP_FROM_EMAIL=

# ── Reglas ───────────────────────────────────────────────────────────────────
RULES_DIR=rules

# ── LLM (opcional, desacoplado) ──────────────────────────────────────────────
LLM_PROVIDER=auto
OPENROUTER_API_KEY=
GROQ_API_KEY=
CMD_API_KEY=
